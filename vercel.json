{
  "rewrites": [
    {
      "source": "/api/nobitex/:path*",
      "destination": "https://apiv2.nobitex.ir/:path*"
    },
    {
      "source": "/api/tsetmc/:path*",
      "destination": "https://cdn.tsetmc.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
